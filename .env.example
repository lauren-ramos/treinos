# Opcional. Sem estas variáveis o app funciona 100% local (dados no aparelho).
# Com elas, habilita login e sincronização com o Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Login pelo Clerk (o mesmo do Plano CIAAR). Opcional: sem isto, o login e o e-mail/senha nativo do Supabase.
# Exige rodar supabase/migrations/0002_clerk.sql, Clerk -> Integrations -> Supabase (Activate)
# e Supabase -> Authentication -> Third-Party Auth -> Clerk.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_SUA-CHAVE
